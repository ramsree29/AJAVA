import java.applet.Applet;
import java.awt.Color;
import java.awt.Graphics;
public class Shapes extends Applet {
    public void init() {
        setBackground(Color.PINK);
        setSize(600, 300);
    }
    public void paint(Graphics g) {
        g.setColor(Color.BLACK);
        g.drawString("GRAPHICS IN APPLET", 220, 30);
        g.setColor(Color.YELLOW);
        int x[] = {50, 20, 80};
        int y[] = {70, 130, 130};
        g.fillPolygon(x, y, 3);
        g.setColor(Color.BLACK);
        g.drawString("Triangle", 30, 155);
        g.setColor(Color.RED);
        g.fillRect(120, 70, 100, 60);
        g.setColor(Color.BLACK);
        g.drawString("Rectangle", 140, 155);
        g.setColor(Color.ORANGE);
        g.fillOval(280, 70, 70, 70);
        g.setColor(Color.BLACK);
        g.drawString("Circle", 295, 155);
        g.setColor(Color.CYAN);
        g.fillRect(420, 70, 70, 70);
        g.setColor(Color.BLACK);
        g.drawString("Square", 435, 165);
    }
}
