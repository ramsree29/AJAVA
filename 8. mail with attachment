package mail;

import javax.mail.Message;
import javax.mail.PasswordAuthentication;
import javax.mail.Session;
import javax.mail.Transport;
import javax.mail.internet.InternetAddress;
import javax.mail.internet.MimeBodyPart;
import javax.mail.internet.MimeMessage;
import javax.mail.internet.MimeMultipart;
import java.io.File;
import java.util.Properties;

public class Mail {

    public static void main(String[] args) {

    
        final String username = "lakshmisree2905@gmail.com";

       
        final String password = "obtzppruftngzjhb";

     
        final String recipient = "lakshmisreejoc@gmail.com";

      
        final String attachmentPath = "Y:/attendance.xlsx";

       
        Properties properties = new Properties();

        properties.put("mail.smtp.host", "smtp.gmail.com");
        properties.put("mail.smtp.port", "587");
        properties.put("mail.smtp.auth", "true");
        properties.put("mail.smtp.starttls.enable", "true");

   
        Session session = Session.getInstance(
                properties,
                new javax.mail.Authenticator() {

                    @Override
                    protected PasswordAuthentication
                    getPasswordAuthentication() {

                        return new PasswordAuthentication(
                                username,
                                password
                        );
                    }
                }
        );

        try {

          
            File file = new File(attachmentPath);

            if (!file.exists()) {
               
                System.out.println("Attachment not found!");
                System.out.println("File: " + attachmentPath);
               
                return;
            }

            System.out.println("Attachment found!");

           
            MimeMessage message = new MimeMessage(session);

         
            message.setFrom(
                    new InternetAddress(username)
            );

         
            message.addRecipient(
                    Message.RecipientType.TO,
                    new InternetAddress(recipient)
            );

          
            message.setSubject(
                    "Student Attendance Details"
            );

            
            MimeMultipart multipart = new MimeMultipart();

           
            MimeBodyPart messageBodyPart =
                    new MimeBodyPart();

            messageBodyPart.setText(
                    "Dear Sir/Madam,\n\n"
                    + "Please find attached the student attendance "
                    + "details for your reference.\n\n"
                    + "Kindly check the attached Excel file.\n\n"
                    + "Thank you for your consideration.\n\n"
                    + "Regards,\n"
                    + "LAKSHMISREE T A"
            );

            multipart.addBodyPart(
                    messageBodyPart
            );

           

            MimeBodyPart attachmentBodyPart =
                    new MimeBodyPart();

            attachmentBodyPart.attachFile(
                    file
            );

            multipart.addBodyPart(
                    attachmentBodyPart
            );

            message.setContent(
                    multipart
            );

          

            System.out.println("Sending email...");

            Transport.send(message);

           
            System.out.println("Email sent successfully!");
            System.out.println("Excel file attached successfully!");
            
        } catch (Exception e) {

            System.out.println("Email could not be sent.");
           
            e.printStackTrace();
        }
    }
}























